# Copy to .env and adjust.
# Host port for the dashboard (change it if 8080 is already in use).
FIRE_PORT=8080
# 127.0.0.1 = only this machine; 0.0.0.0 = anyone on the network (no login!).
FIRE_BIND=127.0.0.1

# ---- Cloudflare Tunnel (only on the server you expose; see docs/deploy-oracle.md) ----
# Uncomment both lines. The token comes from Cloudflare Zero Trust -> Networks -> Tunnels.
# Keep FIRE_BIND=127.0.0.1: the tunnel reaches the app inside Docker, no port needs opening.
#COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
#CF_TUNNEL_TOKEN=
